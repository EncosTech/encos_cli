# 凭证：只通过环境变量传递给发布脚本。
GITEA_USERNAME=
GITEA_TOKEN=
GH_TOKEN=

# 源代码仓库与分支。版本号只从 MAIN_BRANCH 提取。
SOURCE_REPO=https://git.in.encos.cn/bismarckkk/motor_cli.git
MAIN_BRANCH=main
MAIN_SHA1=
OPTIONAL_BRANCHES=

# GitHub 镜像仓库。
GITHUB_RELEASE_REPOSITORY=
GITHUB_RELEASE_REPOSITORY_URL=

# Gitea 通用软件包 emcli-linux-amd64、emcli-linux-arm64 和 emcli-windows-amd64 所在的仓库。
GITEA_URL=https://git.in.encos.cn
GITEA_PACKAGE_OWNER=packages

# 可选配置。
GIT_USER_NAME=Encos Release Bot
GIT_USER_EMAIL=release-bot@encos.cn
GITHUB_API_URL=https://api.github.com
GITHUB_UPLOAD_URL=https://uploads.github.com
